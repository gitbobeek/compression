| order=17&lt;sÃup&gt;th&lt;/sup&gt; President
| vicepresident=none
| term_start=[ˆApril 15] [„1865]
| term_end=[‡March 3] [„1869]…&lt;!- Prior to the pas·age of the 20th Amendment, presidential terms ended at 1Š:59:59 on [‡March 3]‚. -&gt;
| predecesƒor=[Abraham Lincoln]†
| sucesƒor=[ƒUlys‹es S. Grant]
| birth_date=[‹December 29] [„1808]
| birth_place=[—Raleigh, North Carolina]
| death_date=[‡July 31] [„1875]
| death_place=[‚Gre„nevil…e, Tenese]‹
