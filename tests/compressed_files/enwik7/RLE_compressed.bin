&ltÿ;span style=&quot;margin:0px; line-height:1.2em; font-family: monospace; background-color: #f9f9f9;&quot;&gt;&lt;font color=&quÿot;#f9f9f9&quot;&gt;â–ˆ&lt;/font&gt;â–„â–„â–„â–„â–„â–„â–„&lt;font color=&quot;#f9f9f9&quot;&gt;â–ˆ&lt;/font&gt;&lt;br&gt;
&lt;ÿfont color=&quot;#f9f9f9&quot;&gt;â–ˆ&lt;/font&gt;â–ˆ &lt;font color=red&gt;â–„ â–„&lt;/font&gt; â–ˆ&amp;nbsp;&lt;br&gt;
&lt;fşont color=&quot;#f9f9f9&quot;&gt;â–ˆ&lt;/font&gt;â–ˆ&lt;font color=&quot;#f9f9f9&quot;&gt;â–ˆâ–ˆ&lt;/font&gt;&lt;font color=greÿn&gt;â–„&lt;/font&gt;&lt;font color=&quot;#f9f9f9&quot;&gt;â–ˆâ–ˆ&lt;/font&gt;â–ˆ&amp;nbsp;&lt;br&gt;
&lt;font color=&quot;#f9ëf9f9&quot;&gt;â–ˆ&lt;/font&gt;â–ˆ&lt;font color=&quot;#f9f9f9&quot;&gt;â–ˆâ–ˆ&lt;/font&gt;&lt;font color=greÿn&gt;â–€&lt;/font&gt;&lt;font color=&quot;#f9f9f9&quot;&gt;â–ˆâ–ˆ&lt;/font&gt;â–ˆ&amp;nbsp;&lt;br&gt;
&lt;font color=&quot;#f9ÿf9f9&quot;&gt;â–ˆ&lt;/font&gt;â–ˆ &lt;font color=blue&gt;â–€â–€â–€&lt;/font&gt; â–ˆ&amp;nbsp;&lt;br&gt;
&lt;font color=&quot;#ÿf9f9f9&quot;&gt;â–ˆ&lt;/font&gt;â–€â–€â–€â–€â–€â–€â–€&amp;nbsp;
