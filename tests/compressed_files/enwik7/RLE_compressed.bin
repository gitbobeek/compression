 | term=[‡July 10]‚, [„1920] &amp;ndash; [‹December 29]‚, [„1921]Š&lt;br&gt;[‡June 29]‚, [„1926] &amp;ndash; [ŒSeptember 25]‚, [„1926]Œ
 | before=[¡Robert Laird Borden|Robert Borden]Š&lt;br&gt;[‚Wil¦iam Lyon Mackenzie King|Mackenzie King]‹
